# ===========================================
# LOOM — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Required vars will cause startup failure if missing.

# --- Required ---

# OpenAI API key for narrative extraction and dream engine
OPENAI_API_KEY=sk-your-key-here

# --- Optional ---

# Server port (default: 3001)
PORT=3001

# OpenAI model for extraction (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# OpenAI model for dream generation (default: gpt-4o)
DREAM_MODEL=gpt-4o

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Rate limiting: max requests per window (default: 10)
RATE_LIMIT_MAX=10

# Rate limiting: window in minutes (default: 1)
RATE_LIMIT_WINDOW_MINUTES=1

# Maximum input text length in characters (default: 50000)
MAX_INPUT_LENGTH=50000

# Node environment
NODE_ENV=development
